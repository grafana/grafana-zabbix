  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "1. LLD rows (Item pattern): extracted columns, multi-host, last",
      "description": "Expect 5 rows (router-a eth0/eth1/eth2, router-b eth0/eth1), Host column shown automatically (multiple hosts), columns Interface + Alias from capture groups. eth2(DMZ) shows 0 (genuine zero) for Bits in/out and Status 0. router-b eth1 Speed is null (item never received a value). Description is a text column.",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "zabbix-e2e"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "zabbix-e2e"
          },
          "refId": "A",
          "queryType": "7",
          "schema": 13,
          "group": {
            "filter": "E2E Multi-metric"
          },
          "host": {
            "filter": "/.*/"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": ""
          },
          "hostTags": [],
          "evaltype": "0",
          "functions": [],
          "options": {
            "showDisabledItems": false,
            "disableDataAlignment": false,
            "useZabbixValueMapping": false,
            "useTrends": "default"
          },
          "tableConfig": {
            "rowSource": "entityPattern",
            "entityPattern": {
              "searchType": "itemName",
              "pattern": "/^Interface .*/",
              "extractPattern": "Interface (.*)\\((.*)\\): .*",
              "extractedColumns": [
                {
                  "name": "Interface",
                  "groupIndex": 1
                },
                {
                  "name": "Alias",
                  "groupIndex": 2
                }
              ]
            },
            "showGroupColumn": false,
            "showHostColumn": false,
            "metrics": [
              {
                "columnName": "Bits in",
                "searchType": "itemName",
                "pattern": "/: Bits received$/",
                "aggregation": "last",
                "valueType": "num",
                "showSparkline": false
